<Page class="todo-page" navigatingTo="onNavigatingTo" unloaded="onUnloaded" xmlns="http://schemas.nativescript.org/tns.xsd">
    <ActionBar class="todo-bar" title="Today">
        <ActionItem text="Kernel" tap="onOpenPortableKernel" android.position="actionBar" accessibilityLabel="Open Foldkit portable kernel" />
        <ActionItem text="Renderer" tap="onOpenRenderer" android.position="actionBar" accessibilityLabel="Open Foldkit host renderer" />
    </ActionBar>
    <GridLayout rows="auto,auto,auto,auto,auto,auto,*" class="todo-screen" accessibilityLabel="Today tasks">
        <StackLayout row="0" class="todo-heading">
            <GridLayout id="inspectionBanner" columns="*,auto" class="inspection-banner" visibility="collapsed">
                <Label id="inspectionStatus" col="0" text="Inspecting history" verticalAlignment="center" />
                <Button col="1" class="quiet-button" text="Resume live" tap="onResumeLive" accessibilityLabel="Resume live application" />
            </GridLayout>
            <Label id="devtoolsStatus" class="devtools-status" text="Inspector disabled" textWrap="true" />
            <Label id="title" class="todo-heading-title" text="Today" />
            <Label id="summary" class="todo-summary" text="Loading your tasks…" textWrap="true" />
        </StackLayout>

        <GridLayout row="1" columns="*,auto" class="composer">
            <TextField
                id="draft"
                col="0"
                class="composer-field"
                hint="What needs doing?"
                returnKeyType="done"
                textChange="onDraftChanged"
                returnPress="onAdd"
                accessibilityLabel="New task"
            />
            <Button
                id="add"
                col="1"
                class="primary-button"
                text="Add"
                tap="onAdd"
                accessibilityLabel="Add task"
            />
        </GridLayout>

        <StackLayout id="feedback" row="2" class="feedback" visibility="collapsed">
            <Label id="feedbackText" class="feedback-text" textWrap="true" />
            <Button id="retry" class="quiet-button" text="Try again" tap="onRetry" />
        </StackLayout>

        <GridLayout id="editor" row="3" rows="auto,auto" columns="*,auto,auto" class="editor" visibility="collapsed">
            <TextField
                id="editDraft"
                row="0"
                colSpan="3"
                class="editor-field"
                hint="Task title"
                returnKeyType="done"
                textChange="onEditDraftChanged"
                returnPress="onCommitEdit"
                accessibilityLabel="Edit task title"
            />
            <Button row="1" col="1" class="quiet-button" text="Cancel" tap="onCancelEdit" accessibilityLabel="Cancel editing task" />
            <Button row="1" col="2" class="primary-button" text="Save" tap="onCommitEdit" accessibilityLabel="Save edited task" />
        </GridLayout>

        <Label id="motionStatus" row="4" class="devtools-status" text="Motion sensor waiting for a sample" textWrap="true" accessibilityLabel="Accelerometer status" />

        <Button row="5" class="capability-link" text="Try native location" tap="onOpenLocation" accessibilityLabel="Open location capability" />

        <GridLayout row="6">
            <Label
                id="empty"
                class="empty-state"
                text="Nothing here yet. Add one clear next step."
                textWrap="true"
                visibility="collapsed"
            />
            <ListView id="todos" class="todo-list" separatorColor="#E5E5EA">
                <ListView.itemTemplate>
                    <GridLayout columns="48,*,auto,auto" class="todo-row">
                        <Button
                            col="0"
                            class="toggle-button"
                            text="{{ toggleText }}"
                            tap="onToggle"
                            accessibilityLabel="{{ toggleLabel }}"
                        />
                        <Label
                            col="1"
                            class="{{ titleClass }}"
                            text="{{ title }}"
                            textWrap="true"
                            verticalAlignment="center"
                        />
                        <Button
                            col="2"
                            class="row-action"
                            text="Edit"
                            tap="onEdit"
                            accessibilityLabel="{{ editLabel }}"
                        />
                        <Button
                            col="3"
                            class="row-action destructive"
                            text="Delete"
                            tap="onDelete"
                            accessibilityLabel="{{ deleteLabel }}"
                        />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>
        </GridLayout>
    </GridLayout>
</Page>
