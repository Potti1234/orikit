<Page class="location-page" navigatingTo="onNavigatingTo" unloaded="onUnloaded" xmlns="http://schemas.nativescript.org/tns.xsd">
    <ActionBar class="location-bar" title="Native location" />
    <StackLayout class="location-screen" accessibilityLabel="Native location capability">
        <Label class="location-eyebrow" text="PHASE 5 · NATIVE CAPABILITY" />
        <Label class="location-title" text="Location, without native state leaks" textWrap="true" />
        <Label class="location-copy" text="Permission and sensor callbacks become typed messages before they enter the portable program." textWrap="true" />

        <StackLayout class="location-card">
            <Label class="location-label" text="Permission" />
            <Label id="permissionStatus" class="location-value" text="Checking…" textWrap="true" />
            <Label class="location-label location-space" text="Current fix" />
            <Label id="locationStatus" class="location-value" text="Not requested" textWrap="true" />
        </StackLayout>

        <Button id="permissionButton" class="location-primary" text="Allow location access" tap="onRequestPermission" />
        <Button id="locateButton" class="location-secondary" text="Read current location" tap="onReadLocation" />
        <Button id="settingsButton" class="location-secondary" text="Open app settings" tap="onOpenSettings" visibility="collapsed" />
        <Label id="lifecycleStatus" class="location-evidence" text="Lifecycle: Active" />
    </StackLayout>
</Page>
